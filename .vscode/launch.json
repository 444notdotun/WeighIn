{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Vitest tests",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "./node_modules/vitest/vitest.mjs",
        "run",
        "--dir",
        "test",
        "--pool=threads"
      ],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
